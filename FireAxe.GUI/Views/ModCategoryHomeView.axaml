<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FireAxe.ViewModels" xmlns:conv="using:FireAxe.ValueConverters" xmlns:v="using:FireAxe.Views"
             x:Class="FireAxe.Views.ModCategoryHomeView" x:DataType="vm:ModCatalogViewModel">
  <UserControl.Styles>
    <Style Selector="Expander.catalogCategory, Expander.catalogTarget">
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>
    <Style Selector="Button.compact">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Padding" Value="10,6"/>
    </Style>
  </UserControl.Styles>
  <Grid RowDefinitions="Auto,Auto,*" RowSpacing="10" Margin="8,4,0,0">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,0,10,0">
      <StackPanel Spacing="3">
        <TextBlock Text="模组目录" FontSize="23" FontWeight="SemiBold"/>
        <TextBlock Text="分类和对象都可同时展开，调整后点击「应用 Mod」。" Foreground="#9AAFC9" FontSize="12" TextWrapping="Wrap"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
        <Button Classes="compact" Content="重复替换" Command="{Binding ShowOverlaps}" IsVisible="{Binding HasOverlaps}"/>
        <Button Classes="compact" Name="showAllModsButton" Content="完整列表 →" Command="{Binding ShowAll}"/>
      </StackPanel>
    </Grid>
    <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="7" Margin="0,0,10,0">
      <TextBox Text="{Binding CategorySearchText}" Watermark="搜索种类、AK-47、Hunter 或 Mod 名称…" FontSize="14" Padding="12,8"/>
      <Button Grid.Column="1" Classes="compact" Content="展开分类" Command="{Binding ExpandSections}"/>
      <Button Grid.Column="2" Classes="compact" Content="全部收起" Command="{Binding CollapseSections}"/>
    </Grid>
    <ScrollViewer Name="categoryScrollViewer" Grid.Row="2" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled" AllowAutoHide="False">
      <Panel>
        <ItemsControl Name="categoryTree" ItemsSource="{Binding Sections}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ModCategorySection">
              <Border Background="#182333" BorderBrush="#30435B" BorderThickness="1" CornerRadius="10" Margin="0,0,10,10">
                <Expander Name="categoryFolder" Classes="catalogCategory" IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
                  <Expander.Header>
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12" Margin="4,5">
                      <Border Background="#26394F" CornerRadius="9" Width="36" Height="36">
                        <PathIcon Data="{Binding Icon}" Foreground="{Binding Accent}" Width="23" Height="23"/>
                      </Border>
                      <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                      <TextBlock Grid.Column="2" Text="{Binding EnabledText}" FontSize="12" Foreground="#9AAFC9" VerticalAlignment="Center"/>
                      <Border Grid.Column="3" Background="#26394F" CornerRadius="6" Padding="10,5" MinWidth="38" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Count}" FontSize="16" FontWeight="SemiBold" Foreground="{Binding Accent}" HorizontalAlignment="Center"/>
                      </Border>
                    </Grid>
                  </Expander.Header>
                  <StackPanel Margin="14,0,14,14" Spacing="7">
                    <Button Name="openCategoryPageButton" Classes="compact" Content="完整列表 →" Command="{Binding Open}" HorizontalAlignment="Right"/>
                    <ItemsControl ItemsSource="{Binding VisibleChildren}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ModTargetSection">
                          <Border Background="#1D2B3E" CornerRadius="7" Margin="0,0,0,7">
                            <Expander Name="targetFolder" Classes="catalogTarget" IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
                              <Expander.Header>
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="14" Margin="2,2">
                                  <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                  <TextBlock Grid.Column="1" Text="{Binding EnabledText}" FontSize="11" Foreground="#9AAFC9" VerticalAlignment="Center"/>
                                  <TextBlock Grid.Column="2" Text="{Binding Count}" FontSize="14" Foreground="#AFCBE9" MinWidth="25" TextAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                              </Expander.Header>
                              <ItemsControl Name="inlineModList" ItemsSource="{Binding VisibleMods}" Margin="8,0,8,4">
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate x:DataType="vm:VpkAddonViewModel">
                                    <Border Name="inlineModCard" Background="#25354A" CornerRadius="7" Padding="12" Margin="0,0,0,6">
                                      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                        <v:AddonIconView ImageSize="72" SpecialIconSize="0" IsVisible="{Binding ShouldShowImage}" VerticalAlignment="Top"/>
                                        <StackPanel Grid.Column="1" Spacing="4">
                                          <TextBlock Text="{Binding DisplayTitle}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
                                          <TextBlock Text="{Binding CatalogLabel}" Foreground="#95BDF9" FontSize="11" TextWrapping="Wrap"/>
                                          <TextBlock Text="{Binding Info.Author, StringFormat='作者：{0}'}" Foreground="#B7C6D9" FontSize="11"
                                                     IsVisible="{Binding Info.Author, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                          <TextBlock Text="{Binding Info.Description}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" Foreground="#B7C6D9" FontSize="12"
                                                     IsVisible="{Binding Info.Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                          <Expander Header="更改标签" FontSize="11" HorizontalAlignment="Stretch">
                                            <ComboBox Name="inlineCatalogTag" ItemsSource="{Binding CatalogTags}" SelectedItem="{Binding SelectedCatalogTag, Mode=TwoWay}"
                                                      HorizontalAlignment="Stretch" MaxDropDownHeight="360" AutomationProperties.Name="更改 Mod 分类标签">
                                              <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:ModCatalogTag"><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"/></DataTemplate></ComboBox.ItemTemplate>
                                            </ComboBox>
                                          </Expander>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Spacing="6" VerticalAlignment="Center">
                                          <v:AddonNodeEnableButton/>
                                          <Button Name="inlineDetailsButton" Classes="compact" Content="详情 →" Click="OpenModDetails" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                      </Grid>
                                    </Border>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                            </Expander>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="这个分类还没有 Mod。" IsVisible="{Binding VisibleChildren.Count, Converter={x:Static conv:CollectionConverters.IsEmpty}}"
                               Foreground="#9AAFC9" FontSize="12" Margin="8,10"/>
                  </StackPanel>
                </Expander>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="没有找到匹配的分类、对象或 Mod。" HorizontalAlignment="Center" Margin="20,35" Foreground="#9AAFC9"
                   IsVisible="{Binding Sections.Count, Converter={x:Static conv:CollectionConverters.IsEmpty}}"/>
      </Panel>
    </ScrollViewer>
  </Grid>
</UserControl>
