<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FireAxe.ViewModels" xmlns:conv="using:FireAxe.ValueConverters" xmlns:v="using:FireAxe.Views"
             x:Class="FireAxe.Views.ModCategoryHomeView" x:DataType="vm:ModCatalogViewModel">
  <UserControl.Styles>
    <Style Selector="Expander.catalogCategory, Expander.catalogTarget">
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>
    <Style Selector="Button.compact">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Padding" Value="8,4"/>
    </Style>
    <Style Selector="Button.rowAction"><Setter Property="FontSize" Value="11"/><Setter Property="Padding" Value="7,3"/><Setter Property="MinHeight" Value="24"/></Style>
    <Style Selector="Border.modRow"><Setter Property="Background" Value="#25354A"/><Setter Property="BorderBrush" Value="Transparent"/></Style>
    <Style Selector="Border.modRow.located"><Setter Property="Background" Value="#2D4762"/><Setter Property="BorderBrush" Value="#8CCEFF"/></Style>
    <Style Selector="Border.modRow.selected"><Setter Property="Background" Value="#2D4762"/><Setter Property="BorderBrush" Value="#69BFFF"/></Style>
  </UserControl.Styles>
  <Grid RowDefinitions="Auto,Auto,*" RowSpacing="10" Margin="8,4,0,0">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,0,10,0">
      <StackPanel Spacing="3">
        <TextBlock Text="模组目录" FontSize="23" FontWeight="SemiBold"/>
        <TextBlock Text="分类和对象可同时展开；勾选 Mod 的「选择」可用于附加功能，调整后点击「应用 Mod」。" Foreground="#9AAFC9" FontSize="12" TextWrapping="Wrap"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
        <Button Classes="compact" Content="重复替换" Command="{Binding ShowOverlaps}" IsVisible="{Binding HasOverlaps}"/>
        <Button Classes="compact" Name="showAllModsButton" Content="完整列表 →" Command="{Binding ShowAll}"/>
      </StackPanel>
    </Grid>
    <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="7" Margin="0,0,10,0">
      <TextBox Text="{Binding CategorySearchText}" Watermark="搜索种类、AK-47、Hunter 或 Mod 名称…" FontSize="14" Padding="12,8"/>
      <Button Grid.Column="1" Classes="compact" Content="展开分类" Command="{Binding ExpandSections}"/>
      <Button Grid.Column="2" Classes="compact" Content="全部收起" Command="{Binding CollapseSections}"/>
    </Grid>
    <ScrollViewer Name="categoryScrollViewer" Grid.Row="2" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled" AllowAutoHide="False">
      <Panel>
        <ItemsControl Name="categoryTree" ItemsSource="{Binding Sections}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ModCategorySection">
              <Border Background="#182333" BorderBrush="#30435B" BorderThickness="1" CornerRadius="10" Margin="0,0,10,10">
                <Expander Name="categoryFolder" Classes="catalogCategory" IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
                  <Expander.Header>
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="10" Margin="2,1">
                      <Border Background="#26394F" CornerRadius="7" Width="28" Height="28">
                        <PathIcon Data="{Binding Icon}" Foreground="{Binding Accent}" Width="19" Height="19"/>
                      </Border>
                      <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                      <TextBlock Grid.Column="2" Text="{Binding EnabledText}" FontSize="12" Foreground="#9AAFC9" VerticalAlignment="Center"/>
                      <Border Grid.Column="3" Background="#26394F" CornerRadius="5" Padding="8,3" MinWidth="32" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Count}" FontSize="14" FontWeight="SemiBold" Foreground="{Binding Accent}" HorizontalAlignment="Center"/>
                      </Border>
                      <Button Grid.Column="4" Name="openCategoryPageButton" Classes="rowAction" Content="列表 ↗" Command="{Binding Open}"
                              VerticalAlignment="Center" ToolTip.Tip="打开此分类的完整列表"/>
                    </Grid>
                  </Expander.Header>
                  <StackPanel Margin="8,0,8,8" Spacing="0">
                    <ItemsControl ItemsSource="{Binding VisibleChildren}">
                      <ItemsControl.ItemsPanel><ItemsPanelTemplate><v:ModTargetPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ModTargetSection">
                          <Border Background="#1D2B3E" CornerRadius="7">
                            <Expander Name="targetFolder" Classes="catalogTarget" IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
                              <Expander.Header>
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10" Margin="0">
                                  <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                  <TextBlock Grid.Column="1" Text="{Binding EnabledText}" FontSize="11" Foreground="#9AAFC9" VerticalAlignment="Center"/>
                                  <TextBlock Grid.Column="2" Text="{Binding Count}" FontSize="14" Foreground="#AFCBE9" MinWidth="25" TextAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                              </Expander.Header>
                              <ItemsControl Name="inlineModList" ItemsSource="{Binding VisibleMods}" Margin="6,0,6,5">
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate x:DataType="vm:VpkAddonViewModel">
                                    <Border Name="inlineModCard" Classes="modRow" Classes.located="{Binding IsLocated}" Classes.selected="{Binding IsSelected}" BorderThickness="1"
                                            CornerRadius="6" Padding="9" Margin="0,0,0,5" Focusable="True">
                                      <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8">
                                        <CheckBox Name="inlineSelectModCheckBox" Content="选择" IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                  Click="SelectMod" FontSize="11" MinHeight="24" VerticalAlignment="Center"
                                                  ToolTip.Tip="选择此 Mod 用于附加功能，可直接勾选多个；右侧开关控制是否在游戏中启用。"/>
                                        <v:AddonIconView Grid.Column="1" ImageSize="48" SpecialIconSize="0" IsVisible="{Binding ShouldShowImage}" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="2" Spacing="3" VerticalAlignment="Center">
                                          <TextBlock Text="{Binding DisplayTitle}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding DisplayTitle}"/>
                                          <TextBlock Text="{Binding PreviewDescription}" TextTrimming="CharacterEllipsis" Foreground="#C3D1E2" FontSize="12" ToolTip.Tip="{Binding PreviewDescription}"
                                                     IsVisible="{Binding PreviewDescription, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                          <TextBlock Text="{Binding Info.Author, StringFormat='作者：{0}'}" Foreground="#91A8C3" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Info.Author}"
                                                     IsVisible="{Binding Info.Author, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                          <TextBlock Text="{Binding AnimationEditSummary}" Foreground="#FFCE8E" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding AnimationEditSummary}"
                                                     IsVisible="{Binding AnimationEditSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="3" Spacing="1" VerticalAlignment="Center">
                                          <v:AddonNodeEnableButton/>
                                          <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
                                            <Button Name="inlineTagButton" Classes="rowAction" Content="标签" Click="PrepareTagEditor" ToolTip.Tip="{Binding CatalogLabel}">
                                              <Button.Flyout>
                                                <Flyout Placement="BottomEdgeAlignedRight">
                                                  <StackPanel Spacing="8" Width="300">
                                                    <TextBlock Text="分类标签 · 唯一归属" FontSize="14" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding CatalogLabel}" Foreground="#9AAFC9" TextWrapping="Wrap" FontSize="12"/>
                                                    <ComboBox Name="inlineCatalogTag" ItemsSource="{Binding CatalogTags}" SelectedItem="{Binding SelectedCatalogTag, Mode=TwoWay}"
                                                              HorizontalAlignment="Stretch" MaxDropDownHeight="300" AutomationProperties.Name="更改 Mod 分类标签">
                                                      <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:ModCatalogTag"><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"/></DataTemplate></ComboBox.ItemTemplate>
                                                    </ComboBox>
                                                  </StackPanel>
                                                </Flyout>
                                              </Button.Flyout>
                                            </Button>
                                            <Button Name="inlineFileLocationButton" Classes="rowAction" Content="文件位置" Command="{Binding ShowInFileExplorer}"
                                                    ToolTip.Tip="{Binding Addon.VpkFilePath}"/>
                                            <Button Name="inlineDetailsButton" Classes="rowAction" Content="详情 ↗" Click="OpenModDetails"/>
                                            <Button Name="inlineDeleteModButton" Classes="rowAction" Content="删除" Foreground="#F4ADAD"
                                                    Command="{Binding $parent[v:AddonNodeExplorerView].ViewModel.DeleteModCommand}" CommandParameter="{Binding Addon}"
                                                    ToolTip.Tip="删除此 Mod 及文件；确认窗口会显示名称"/>
                                          </StackPanel>
                                        </StackPanel>
                                      </Grid>
                                    </Border>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                            </Expander>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="这个分类还没有 Mod。" IsVisible="{Binding VisibleChildren.Count, Converter={x:Static conv:CollectionConverters.IsEmpty}}"
                               Foreground="#9AAFC9" FontSize="12" Margin="8,10"/>
                  </StackPanel>
                </Expander>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="没有找到匹配的分类、对象或 Mod。" HorizontalAlignment="Center" Margin="20,35" Foreground="#9AAFC9"
                   IsVisible="{Binding Sections.Count, Converter={x:Static conv:CollectionConverters.IsEmpty}}"/>
      </Panel>
    </ScrollViewer>
  </Grid>
</UserControl>
